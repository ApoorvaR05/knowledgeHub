# ─────────────────────────────────────────────────────────────────────────────
# Knowledge Hub — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection string (with pgvector extension enabled)
# Docker Compose sets this automatically via the service name "postgres"
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_hub

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Required for embeddings (text-embedding-ada-002) and chat completions (GPT-4)
# Get yours at: https://platform.openai.com/api-keys
# ⚠️  NEVER bake this into a Docker image — always inject at runtime
OPENAI_API_KEY=sk-...

# ── Authentication ────────────────────────────────────────────────────────────
# Long random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Token expiry — accepts ms strings (e.g. "24h", "7d") or milliseconds
JWT_EXPIRES_IN=24h

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Client (Vite build-time variables) ───────────────────────────────────────
# Base URL of the Express API — no trailing slash
# Used by the React app to make API calls
VITE_API_URL=http://localhost:4000

# Set to "true" to activate MSW mock API (no real backend needed)
# Set to "false" (or omit) to use the real API
VITE_ENABLE_MOCKS=false
